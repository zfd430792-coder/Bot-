# ─── Обязательное ────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# ─── Необязательное ──────────────────────────────────────────────────────────
# Чат/канал для логов. Если пусто — логи идут первому админу из ADMIN_IDS.
LOG_CHAT_ID=

# Путь к файлу базы данных (анкеты, лайки, жалобы, статистика)
DB_PATH=data/bot.db

# Redis — хранилище диалогов (FSM). Обязателен: состояние переживает
# перезапуск бота и общее для нескольких воркеров.
# Поднять быстро: docker run -d -p 6379:6379 --name redis redis:7-alpine
REDIS_URL=redis://localhost:6379/0
# Префикс ключей — если на одном Redis живёт несколько ботов
REDIS_PREFIX=dating

# Лимит лайков в сутки на пользователя
LIKES_LIMIT_PER_DAY=50

# Возрастные рамки анкеты
MIN_AGE=18
MAX_AGE=99

# Радиус поиска по геопозиции (км) по умолчанию
DEFAULT_RADIUS_KM=50

# Максимальная длительность видео в анкете (сек)
MAX_VIDEO_SECONDS=15

# Сколько секунд читать предупреждение перед появлением кнопки "Принимаю"
RULES_DELAY_SECONDS=5

# Капча
CAPTCHA_MAX_ATTEMPTS=3
CAPTCHA_MAX_REFRESH=3
CAPTCHA_BLOCK_MINUTES=15
CAPTCHA_TIMEOUT_SECONDS=150
CAPTCHA_MIN_SOLVE_MS=2000

# Антифлуд: минимальный интервал между действиями (сек)
THROTTLE_SECONDS=0.4

# ─── Антинакрутка лайков ─────────────────────────────────────────────────────
# Первое нарушение — повторная капча, второе — бан на AF_BAN_HOURS,
# третье — бессрочный бан. Админ получает уведомление с кнопкой разбана.
ANTIFRAUD_ENABLED=1
# Реакция быстрее этого времени считается машинной (сек)
AF_FAST_SECONDS=1.2
# Столько быстрых реакций подряд — сигнал
AF_FAST_STREAK=12
# На скольких последних реакциях смотрим долю лайков
AF_RATIO_WINDOW=30
# Доля лайков, после которой это накрутка (0.95 = 29 лайков из 30)
AF_RATIO_THRESHOLD=0.95
# Срок автобана на втором нарушении (часы)
AF_BAN_HOURS=24

# ─── Напоминания уснувшим пользователям ──────────────────────────────────────
REENGAGEMENT_ENABLED=1
# Через сколько часов молчания напомнить о себе
INACTIVE_HOURS=24
# Не чаще одного напоминания в этот срок (часы)
REMINDER_COOLDOWN_HOURS=72
# После стольких проигнорированных напоминаний бот замолкает
REMINDER_MAX_COUNT=3
# Ночью не беспокоим (местный час считается по долготе из анкеты)
QUIET_HOURS_START=22
QUIET_HOURS_END=9

# Онлайн-геокодер (OpenStreetMap Nominatim) для городов, которых нет в
# локальной базе. 0 = выключен (бот работает полностью офлайн).
GEOCODER_ENABLED=0
# Nominatim требует контактный e-mail в User-Agent
GEOCODER_EMAIL=
